{
  "name": "@pacrypto55/privy-onramp",
  "version": "1.0.0",
  "description": "Privy on-ramp for Orderly DEXes. Lets a connected user buy crypto straight into their embedded wallet via Privy's funding flow. Adds itself as a row in the shared @pacrypto55/wallet-menu 'Privy Wallet' button.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@orderly.network/plugin-core": "^3.1.0",
    "@orderly.network/ui": "^3.1.0",
    "@pacrypto55/wallet-menu": "^1.0.0",
    "@privy-io/react-auth": "^2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@orderly.network/plugin-core": "^3.1.3",
    "@orderly.network/ui": "^3.1.3",
    "@pacrypto55/wallet-menu": "file:../wallet-menu",
    "@privy-io/react-auth": "^2.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "orderly",
    "privy",
    "onramp",
    "dex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pacrypto55/privy-onramp.git"
  }
}
